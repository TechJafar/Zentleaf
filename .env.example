# Zentleaf Environment Configuration Template
# Copy this file to .env or .env.local to configure custom local or production environment settings.

# Port for local dev server (default: 3000)
PORT=3000

# Base URL / Domain
VITE_SITE_URL=https://Zentleaf.com

# Optional: Contact Form Endpoint / Webhook (if connecting external CRM or email service)
# VITE_CONTACT_API_URL=https://api.Zentleaf.com/v1/contact

# Optional: Application Monitoring / Analytics
# VITE_ANALYTICS_ID=


